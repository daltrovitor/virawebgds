# Copie para .env.local e ajuste. Nunca versione segredos reais.

# Banco PostgreSQL (local: `npm run db:local`; produção: Supabase/Neon/RDS etc.)
DATABASE_URL=postgres://postgres:odonto_local_dev@127.0.0.1:54329/odonto
DATABASE_POOL_MAX=10
# Use false com poolers em modo transação (ex.: Supabase porta 6543)
DATABASE_PREPARE=true

# Aplicação
APP_URL=http://localhost:3100
APP_ENV=development
# Segredo para links temporários e criptografia de MFA (mínimo 32 caracteres; gere com `openssl rand -base64 48`)
APP_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Nome comercial ainda não definido: ajuste aqui
NEXT_PUBLIC_PRODUCT_NAME=Gestão Odonto

# Arquivos privados: local (desenvolvimento) ou supabase (produção)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=clinic-files

# E-mail transacional (opcional). Sem isso, convites/redefinições usam link gerado pelo administrador.
# RESEND_API_KEY=
# EMAIL_FROM=Clinica <no-reply@seudominio.com.br>

# Senha dos usuários sintéticos do seed de demonstração (somente ambiente de demonstração)
DEMO_PASSWORD=demo-odonto-2026
